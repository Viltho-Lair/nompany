node_modules
.next
out
.DS_Store
npm-debug.log*

# Generated live data (recreated from data/seed.json)
data/db.json

.vercel
.env*

# TypeScript incremental build cache.
tsconfig.tsbuildinfo

# Turbopack's profiler drops these in the repo root when NEXT_CPU_PROF is set,
# and once in a directory literally named `undefined`.
*.cpuprofile
/undefined/

# Local-only dev login portal (never committed, never deployed)
src/app/api/dev-login/

# Media exported from production by scripts/migrate-media-to-blob.mjs. Real
# customer files — never committed, and deleted once the migration is proven.
media-export/

# Rows exported by scripts/migrate/seal-clients.mjs before it seals them. Client
# data in the clear — never committed, and deleted once the run is proven.
seal-export/

# Old ID/passport fields exported by scripts/migrate/identity-documents.mjs before
# it deletes them. Never committed; deleted once the run is proven.
hr-export/

# Documents exported by scripts/migrate/rekey-field-crypto.mjs before it
# re-encrypts them. Never committed; deleted once the run is proven.
rekey-export/

# The pg-gateway bundle. esbuild output, rebuilt by `npm run build` on every
# `npm start` and inside the image build — a committed copy would be a second
# source of truth for code that already lives in src/.
services/pg-gateway/dist/
