      "hint": { "en": "15 digits, starting and ending with 3.", "ar": "15 رقما، يبدأ وينتهي بالرقم 3." },
      "required": "conditional",
      "appliesWhen": { "vatRegistered": true },
      "normalize": "digits",
      "patterns": ["^3\\d{13}3$"],
      "maxLength": 20,
      "showOn": ["invoice", "quote", "receipt"],
      "source": { "label": "fonoa — Saudi tax guide", "url": "https://www.fonoa.com/resources/country-tax-guides/saudi-arabia", "checked": "2026-09-18", "status": "checked" }
    },
