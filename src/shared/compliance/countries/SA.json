  "fields": [
    {
      "key": "legal_name_ar",
      "department": "company",
      "label": { "en": "Legal name in Arabic", "ar": "الاسم القانوني بالعربية" },
      "hint": { "en": "As registered — Arabic is mandatory on Saudi invoices.", "ar": "كما هو مسجل — العربية إلزامية في الفواتير السعودية." },
      "required": "mandatory",
      "normalize": "trim",
      "maxLength": 200,
      "showOn": ["invoice", "quote", "receipt", "contract", "letter"],
      "source": { "label": "ZATCA e-invoicing", "url": "https://zatca.gov.sa/en/E-Invoicing/Pages/default.aspx", "checked": "2026-09-16", "status": "earlier" }
    },
    {
      "key": "commercial_registration_number",
      "department": "company",
      "label": { "en": "Commercial registration (Unified National Number)", "ar": "السجل التجاري (الرقم الوطني الموحد)" },
      "hint": { "en": "10 digits starting with 7. Older CR numbers are still accepted until April 2030.", "ar": "10 أرقام تبدأ بالرقم 7. تقبل أرقام السجل القديمة حتى أبريل 2030." },
      "required": "mandatory",
      "normalize": "digits",
      "patterns": ["^7\\d{9}$", "^[1-5]\\d{9}$"],
      "maxLength": 20,
      "showOn": ["invoice", "quote", "contract", "letter"],
      "source": { "label": "SAMA rulebook — Commercial Register Law", "url": "https://rulebook.sama.gov.sa/en/emphasizing-implementation-provisions-commercial-register-law-and-law-tradenames", "checked": "2026-09-18", "status": "checked" }
    },
    {
