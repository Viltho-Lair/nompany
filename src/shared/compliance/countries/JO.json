      "department": "company",
      "label": { "en": "Commercial registration number", "ar": "رقم السجل التجاري" },
      "hint": { "en": "As on the registration certificate.", "ar": "كما في شهادة التسجيل." },
      "required": "mandatory",
      "normalize": "trim",
      "maxLength": 40,
      "showOn": ["invoice", "quote", "contract", "letter"],
      "source": { "label": "Companies Control Department", "url": "https://www.ccd.gov.jo", "status": "uncertain" }
    },
    {
      "key": "company_national_number",
