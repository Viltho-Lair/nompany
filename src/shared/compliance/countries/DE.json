      "normalize": "compact",
      "patterns": ["^HR[AB]\\d{1,6}[A-Z]?$"],
      "maxLength": 14,
      "showOn": ["invoice", "quote", "contract", "letter"],
      "source": { "label": "Handelsregister", "url": "https://www.handelsregister.de", "status": "not-rechecked" }
    },
    {
